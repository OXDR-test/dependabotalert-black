REDIS_PASSWORD=
REDIS_DB=0

# ===========================================
# FRONTEND CONFIGURATION
# ===========================================

# Port exposed to host
FRONTEND_PORT=3100

# Base path configuration - change this to deploy at different paths
# Examples:
#   BASE_PATH="" or BASE_PATH="/" -> Deploy at http://example.com/
#   BASE_PATH="/oxdr/uemp"         -> Deploy at http://example.com/oxdr/uemp/
#   BASE_PATH="/oxdr/emp"          -> Deploy at http://example.com/oxdr/emp/
BASE_PATH=""

# Backend API URL (internal Docker network)
BACKEND_URL=http://backend:9000/api/

# Organization Configuration
VITE_DEFAULT_ORG=infopercept

# ===========================================
# ENRICHMENT & SCORING CONFIGURATION
# ===========================================

# Feed URLs for enrichment data
